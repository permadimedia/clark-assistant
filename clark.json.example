{
  "telegram": {
    "token": "",
    "default_chat_id": 0
  },
  "deploy": {
    "host": "127.0.0.1",
    "port": 8124,
    "workers": 1,
    "memory_max": "256M",
    "cpu_quota": "50%"
  },
  "database": {
    "path": "data/assistant.db"
  },
  "modules": {
    "agenda": { "enabled": true },
    "notes": { "enabled": true },
    "reminders": { "enabled": true },
    "scheduler": { "enabled": true },
    "uptime": { "enabled": true },
    "email_automation": {
      "enabled": false,
      "provider": "gmail",
      "credentials_path": "~/.config/email/credentials.json",
      "token_path": "~/.config/email/token.json",
      "scan_schedule": "0 7 * * *",
      "scan_limit": 50,
      "chat_id": 0,
      "labels_enabled": true,
      "archive_read_after_days": 90,
      "trash_draft_after_days": 30,
      "read_only": true
    }
  }
}
