[Unit]
Description=clark — REST API backend for agentic AI
Documentation=https://github.com/permadihendra/clark-assistant
After=network.target

[Service]
Type=simple
User={{user}}
WorkingDirectory={{working_dir}}
ExecStart={{python_path}} -m uvicorn app.main:app --host {{host}} --port {{port}} --workers {{workers}} --no-access-log
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
MemoryMax={{memory_max}}
CPUQuota={{cpu_quota}}

[Install]
WantedBy=default.target
